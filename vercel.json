{
  "outputDirectory": "public",
  "redirects": [
    { "source": "/principles.html", "destination": "/#doctrine", "permanent": true },
    { "source": "/principles", "destination": "/#doctrine", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/framing-engine", "destination": "/framing-engine.html" },
    { "source": "/guest-desk", "destination": "/guest-desk.html" }
  ]
}
